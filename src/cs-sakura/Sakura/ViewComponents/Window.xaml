<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vc="clr-namespace:Haru.Kei.ViewComponents"
    xmlns:views="clr-namespace:Haru.Kei.Views"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="CustomWindowCommandsStyle" TargetType="mah:WindowCommands" BasedOn="{StaticResource MahApps.Styles.WindowCommands}"></Style>
    <Style TargetType="{x:Type mah:WindowButtonCommands}">
        <Style.Triggers>
            <DataTrigger
                Binding="{Binding IsActive, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type mah:MetroWindow}}}"
                Value="True">
                <Setter Property="Foreground">
                    <Setter.Value>
                        <SolidColorBrush Color="{DynamicResource Primary700Foreground}" />
                    </Setter.Value>
                </Setter>
            </DataTrigger>

            <DataTrigger
                Binding="{Binding IsActive, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type mah:MetroWindow}}}"
                Value="False">
                <Setter Property="Foreground">
                    <Setter.Value>
                        <SolidColorBrush Color="{DynamicResource Primary200Foreground}" />
                    </Setter.Value>
                </Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type vc:BaseWindow}" BasedOn="{StaticResource {x:Type mah:MetroWindow}}">
        <Setter Property="TitleForeground">
            <Setter.Value>
                <SolidColorBrush Color="{DynamicResource Primary500Foreground}" />
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush">
            <Setter.Value>
                <SolidColorBrush Color="{DynamicResource Primary700}" />
            </Setter.Value>
        </Setter>
        <Setter Property="GlowBrush">
            <Setter.Value>
                <SolidColorBrush Color="{DynamicResource Primary700}" />
            </Setter.Value>
        </Setter>
        <Setter Property="NonActiveBorderBrush">
            <Setter.Value>
                <SolidColorBrush Color="{DynamicResource Primary200}" />
            </Setter.Value>
        </Setter>
        <Setter Property="NonActiveWindowTitleBrush">
            <Setter.Value>
                <SolidColorBrush Color="{DynamicResource Primary200}" />
            </Setter.Value>
        </Setter>

        <Setter Property="TitleCharacterCasing" Value="Normal" />

        <Style.Triggers>
            <Trigger Property="IsActive" Value="False">
                <Setter Property="TitleForeground">
                    <Setter.Value>
                        <SolidColorBrush Color="{DynamicResource Primary200Foreground}" />
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
        <!--
        <Setter Property="RightWindowCommands">
            <Setter.Value>
                <mah:WindowCommands Style="{StaticResource CustomWindowCommandsStyle}">
                    <Button Content="設定" />
                    <Button Content="ログイン" />
                    <Button
                FontFamily="{DynamicResource __SymbolFont}"
                Content="{DynamicResource __ChromeMinimize}"
                />
                </mah:WindowCommands>
            </Setter.Value>
        </Setter>
        -->
    </Style>

    <Style TargetType="{x:Type views:MainWindow}" BasedOn="{StaticResource {x:Type vc:BaseWindow}}">
    </Style>
</ResourceDictionary>
